# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode is automatic when Supabase is not configured.
# Force demo even with other keys:
# USE_DEMO_STORE=true

# Optional: pin when the demo artwork "went live" (ISO string)
# DEMO_LIVE_AT=2026-07-11T00:00:00.000Z

# --- Supabase (Phase 2+) ---
# Create a project at https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Phase 3+) — embedded Payment Element ---
# https://dashboard.stripe.com/apikeys (use test keys first)
# Both keys required for real on-page checkout (publishable is used by the browser).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhook/stripe`
# Dashboard webhook must listen for: payment_intent.succeeded
STRIPE_WEBHOOK_SECRET=

# --- Secrets for cron + admin helpers ---
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me-cron
# POST /api/admin with Authorization: Bearer <ADMIN_SECRET>
ADMIN_SECRET=change-me-admin
